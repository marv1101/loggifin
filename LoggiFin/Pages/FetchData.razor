@page "/fetchdata"
@using LoggiFin.DBO;
@using LoggiFin.Data;
@using System.Globalization;
@using LoggiFin.Global;
@using LoggiFin.Services;

@inject NavigationManager uriHelper;
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IJSRuntime JS

<PageTitle>Data Input</PageTitle>

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="5000" Placement="ToastsPlacement.TopRight" />

<h1>Daten Eingeben</h1>

<ConfirmDialog @ref="dialog" />

<div>
    <p>Bitte die Daten eingeben.</p>
</div>

<div>
    <div class="mb-3">
        <label>Datum</label>
        <DateInput TValue="DateOnly" @bind-Value="@date1" Placeholder="Enter Date" />
        <label>Einnahmen</label>
        <CurrencyInput TValue="Decimal" @bind-Value="@einnahmen" Placeholder="Einnahmen" />
        <label>Ausgaben</label>
        <CurrencyInput TValue="Decimal" @bind-Value="@ausgaben" Placeholder="Ausgaben" />
        <label>Kontostand</label>
        <CurrencyInput TValue="double" @bind-Value="@kontostand" Placeholder="Kontostand" />
        <label>Sparkonto</label>
        <CurrencyInput TValue="double" @bind-Value="@sparkonto" Placeholder="Sparkonto" />
        <label>Scalable Sparplan</label>
        <CurrencyInput TValue="double" @bind-Value="@scalableSparplan" Placeholder="Scalable Sparplan" />
        <label>Scalable Total Invest</label>
        <CurrencyInput TValue="double" @bind-Value="@scalableTotal" Placeholder="Scalable Sparplan" />
        <label>Volksbank Sparplan</label>
        <CurrencyInput TValue="double" @bind-Value="@volksbankSparplan" Placeholder="Volksbank Sparplan" />
        <label>Volksbank Total Invest</label>
        <CurrencyInput TValue="double" @bind-Value="@volksbankTotal" Placeholder="Volksbank Sparplan" />
        <label>Beschreibung Transfer</label>
        <InputText @bind-Value="@descr">Beschreibung</InputText>
        <br /><label>Transfermenge</label>
        <CurrencyInput TValue="double" @bind-Value="@transfer" Placeholder="Transfer" />
        <label>Bargeld</label>
        <CurrencyInput TValue="double" @bind-Value="@bargeld" Placeholder="Bargeld" />
        <label>Urlaubsgeld</label>
        <CurrencyInput TValue="double" @bind-Value="@urlaubskasse" Placeholder="Urlaubskasse" />
        <Button Color="ButtonColor.Success" Outline="true" @onclick="() => sendData()"> Daten senden </Button>

        <br /><br />

        <label>Datensatz ID</label>
        <NumberInput TValue="int" @bind-Value="@datasetID" />
        <label>Kommentar</label>
        <InputText @bind-Value="@comment" />
        <Button Color="ButtonColor.Success" Outline="true" @onclick="() => sendComment()"> Kommentar senden </Button>
        
        <br /><br />
        <label>ID zum löschen</label>
        <NumberInput TValue="int" @bind-Value="@idToDelete" Placeholder="ID eingeben"  />
        <Button Color="ButtonColor.Danger" @onclick="deleteData"> Datenreihe löschen </Button>

        <br /><br />
        <label>ID zum löschen von Kommentar</label>
        <NumberInput TValue="int" @bind-Value="@idCommentToDelete" Placeholder="ID eingeben" />
        <Button Color="ButtonColor.Danger" @onclick="deleteComment"> Kommentar löschen </Button>
    </div>

    @code {
        List<ToastMessage> messages = new List<ToastMessage>();
        private DateOnly date1 = DateOnly.FromDateTime(DateTime.Now);
        private Decimal einnahmen = 0;
        private Decimal ausgaben = 0;
        private double kontostand = 0;
        private double sparkonto = 0;
        private double scalableSparplan = 0;
        private double volksbankSparplan = 0;
        private double transfer = 0;
        private double bargeld = 0;
        private double urlaubskasse = 0;
        private double volksbankTotal = 0;
        private double scalableTotal = 0;
        string descr = "";
        int datasetID = -1;
        string comment = "";
        APIConnector api = new APIConnector();
        bool loggedIn = false;
        int uid = -1;

        private ConfirmDialog dialog;
        int idToDelete = -1;
        int idCommentToDelete = -1;

        private async void sendData()
        {
            if (loggedIn)
            {
                if (descr.Replace(" ", "") != "")
                {

                    JsonDatarow datarowToAdd = new JsonDatarow();
                    datarowToAdd.date = date1;
                    Console.WriteLine(datarowToAdd.GetDate());
                    datarowToAdd.Einnahmen = einnahmen;
                    datarowToAdd.Ausgaben = ausgaben;
                    datarowToAdd.Kontostand = kontostand;
                    datarowToAdd.Sparkontostand = sparkonto;
                    datarowToAdd.ScalableSparplan = scalableSparplan;
                    datarowToAdd.VolksbankSparplan = volksbankSparplan;
                    datarowToAdd.ScalableSparplanTotal = scalableTotal;
                    datarowToAdd.VolksbankSparplanTotal = volksbankTotal;
                    datarowToAdd.Beschreibung = descr;
                    datarowToAdd.TransferMenge = transfer;
                    datarowToAdd.Bargeld = bargeld;
                    datarowToAdd.Urlaubskasse = urlaubskasse;

                    await api.postDatarow(datarowToAdd, uid);

                    confirmSend();

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);


                }
                else
                {
                    denySend();
                }
            }
            else
            {
                denySend();
            }




        }

        private async void sendComment()
        {
            if (loggedIn)
            {
                if (comment.Replace(" ", "") != "")
                {
                    Boolean res = await api.postComment(datasetID, comment);

                    if (!res)
                    {
                        denySend();
                        return;
                    }

                    confirmSend();

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {
                    denySend();
                }
            }
        }

        private async Task deleteData()
        {
            if (loggedIn)
            {
                var confirmation = await dialog.ShowAsync(
                title: "Wirklich löschen?",
                message1: "Eintrag wird gelöscht. Aktion kann nicht rückgängig gemacht werden.",
                message2: "Fortfahren?");

                if (confirmation)
                {
                    Boolean res = await api.deleteDatarow(idToDelete, uid);

                    if (!res)
                    {
                        return;
                    }

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {

                }
            }

        }

        private async Task deleteComment()
        {
            if (loggedIn)
            {
                var confirmation = await dialog.ShowAsync(
                title: "Wirklich löschen?",
                message1: "Eintrag wird gelöscht. Aktion kann nicht rückgängig gemacht werden.",
                message2: "Fortfahren?");

                if (confirmation)
                {
                    Boolean res = await api.deleteComment(idCommentToDelete);

                    if (!res)
                    {
                        return;
                    }

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {

                }
            }
        }

        private void confirmSend()
        {
            messages.Add(new ToastMessage(ToastType.Success, "Daten gesendet", $"{DateTime.Now}",
            $"Daten wurden erfolgreich übermittelt!"));
        }

        private void denySend()
        {
            messages.Add(new ToastMessage(ToastType.Danger, "Daten wurden nicht gesendet gesendet", $"{DateTime.Now}",
            $"Daten wurden nicht erfolgreich übermittelt! Bitte alles ausfüllen und anmelden"));
        }
    }
</div>

<div>

    <h4>Datenzeitraum anzeigen:</h4>
    <label for="from">Von</label>
    <DateInput TValue="DateOnly" id="from" Value="start" ValueExpression="() => start" ValueChanged="(val) =>  ReloadGridCauseFrom(val)" />

    <label for="to">bis</label>
    <DateInput TValue="DateOnly" id="to" Value="end" ValueExpression="() => end" ValueChanged="(val) => ReloadGridCauseTo(val)" />

    <Grid @ref="grid"
      TItem="JsonDatarow"
      Class="table table-hover table-bordered table-striped"
      DataProvider="LoggingRowDataProvider"
      AllowFiltering="true"
      AllowSorting="true"
      Responsive="true"
      RowClass="getRowClass"
      AllowPaging="true"
      PageSize="12">

    <GridColumn TItem="JsonDatarow" HeaderText="Id" PropertyName="RowId">
        <Tooltip Title="@getCommentString(context.RowId)">@context.RowId</Tooltip>
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Datum" PropertyName="date" SortString="Date" SortKeySelector="item => item.GetDate()" IsDefaultSortColumn="true" SortDirection="SortDirection.Descending">
        <Tooltip Title="@context.getProfitsAsEuro()">@context.GetDate()</Tooltip>
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Einnahmen" PropertyName="Einnahmen" SortString="Einnahmen" SortKeySelector="item => item.Einnahmen">
        @context.Einnahmen.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Ausgaben" PropertyName="ausgaben" SortString="Ausgaben" SortKeySelector="item => item.Ausgaben">
        @context.Ausgaben.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Kontostand" PropertyName="kontostand" SortString="Kontostand" SortKeySelector="item => item.Kontostand">
        @context.Kontostand.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Sparkontostand" PropertyName="sparkontostand" SortString="Sparkontostand" SortKeySelector="item => item.Sparkontostand">
        @context.Sparkontostand.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Scalable Sparplan" PropertyName="scalableSparplan" SortString="Scalable Sparplan" SortKeySelector="item => item.ScalableSparplan">
        @context.ScalableSparplan.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Scalable Sparplan Total" PropertyName="scalableSparplanTotal" SortString="Scalable Sparplan Total" SortKeySelector="item => item.ScalableSparplanTotal">
        @context.ScalableSparplanTotal.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Volksbank Sparplan" PropertyName="volksbankSparplan" SortString="Volksbank Sparplan" SortKeySelector="item => item.VolksbankSparplan">
        @context.VolksbankSparplan.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Volksbank Sparplan Total" PropertyName="volksbankSparplanTotal" SortString="Volksbank Sparplan Total" SortKeySelector="item => item.VolksbankSparplanTotal">
        @context.VolksbankSparplanTotal.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Transfer" PropertyName="amountTotal" SortString="Transfer" SortKeySelector="item => item.TransferMenge">
        <Tooltip Title="@FinLoggingDataService.getTransferText(@context.RowId, uid)">@context.TransferMenge.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))</Tooltip>
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Bargeld" PropertyName="Bargeld" SortString="Bargeld" SortKeySelector="item => item.Bargeld">
        @context.Bargeld.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Urlaubskasse" PropertyName="Urlaubskasse" SortString="Urlaubskasse" SortKeySelector="item => item.Urlaubskasse">
        @context.Urlaubskasse.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="JsonDatarow" HeaderText="Gesamtvermögen" PropertyName="gesamt" SortString="Gesamt" SortKeySelector="item => item.getTotalBalance()">
        @context.getTotalBalance().ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>

</Grid>

<br />

<Button title="Export" @onclick="DownloadFileFromStream" Color="ButtonColor.Primary">Export</Button>



    @code {
        BlazorBootstrap.Grid<JsonDatarow> grid = default!;
        private IEnumerable<JsonDatarow> dataRows = default!;


        private DateOnly start = DateOnly.FromDateTime(DateTime.Now.Subtract(TimeSpan.FromDays(365)));
        private DateOnly end = DateOnly.FromDateTime(DateTime.Now.Add(TimeSpan.FromDays(1)));

        private async Task DownloadFileFromStream()
        {
            CSVExporter exporter = new CSVExporter(dataRows.ToList());
            using (var streamBuff = exporter.getFileStreamForDownload())
            {
                var fileName = "export.csv";

                using var streamRef = new DotNetStreamReference(stream: streamBuff);

                await Task.Delay(TimeSpan.FromMilliseconds(1000));

                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
        }

        protected override async Task OnInitializedAsync()
        {
            await checkLogin();
            if (!loggedIn)
            {
                uriHelper.NavigateTo("/login");
            }
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {

            await base.OnAfterRenderAsync(firstRender);
        }

        private async Task ReloadGridCauseFrom(DateOnly f)
        {
            if(grid != null)
            {
                start = f;
                await grid.RefreshDataAsync();
            }
        }

        private async Task ReloadGridCauseTo(DateOnly to)
        {
            if (grid != null)
            {
                end = to;
                await grid.RefreshDataAsync();
            }
        }

        private async Task ReloadGrid()
        {
            if (grid != null)
            {
                APIConnector connector = new APIConnector();
                dataRows = await connector.getDataRowsAsync(uid, start, end);
                await grid.RefreshDataAsync();
            }
        }

        private async Task<GridDataProviderResult<JsonDatarow>> LoggingRowDataProvider(GridDataProviderRequest<JsonDatarow> request)
        {
            await checkLogin();
            if (loggedIn)
            {
                if (dataRows is null)
                {
                    APIConnector connector = new APIConnector();
                    if(uid > 0)
                    {
                        Console.WriteLine(start);
                        Console.WriteLine(end);
                        dataRows = await connector.getDataRowsAsync(uid, start, end);
                    }
                    
                    
                }
                return await Task.FromResult(request.ApplyTo(dataRows));
            }
            else
            {
                return null;
            }



        }

        private string getRowClass(JsonDatarow finLoggingDataRow)
        {
            if(finLoggingDataRow.Ausgaben > finLoggingDataRow.Einnahmen)
            {
                return "table-danger";
            }
            else
            {
                return "";
            }
        }

        private async Task checkLogin()
        {
            var token = "";
            int userId = -1;

            for (int i = 0; i < 5; i++)
            {
                try
                {
                    token = await sessionStorage.GetItemAsync<string>("LoggedIn");
                    userId = await sessionStorage.GetItemAsync<int>("uid");
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                }


                if (token != null && token.Equals("true"))
                {
                    loggedIn = true;
                    uid = userId;
                    await ReloadGrid();
                    StateHasChanged();
                    return;
                }
                else
                {
                    loggedIn = false;
                }
            }


            StateHasChanged();
        }

        private string getCommentString(int datasetID)
        {
            List<Kommentar>? res = api.getCommentsForDataset(datasetID);

            String stringRes = "";

            foreach (Kommentar com in res)
            {
                stringRes += com.kommentarID_PK + "-" + com.kommentar + "; ";
            }

            return stringRes;
        }

}
</div>