@page "/visualization"

@using BlazorBootstrap.Extensions
@using Color = System.Drawing.Color
@using LoggiFin.Data
@using LoggiFin.Global;

@inject BrowserService Service


<PageTitle>Diagrams</PageTitle>

<Tabs>
    <Tab Title="Diagram Einnahmen vs. Ausgaben" IsActive="true">
        <Content>

            <BarChart @ref="inOutChart" Width="@width" Class="mb-4" />

        </Content>
    </Tab>
    <Tab Title="Diagram Vermögensentwicklung">
        <Content>
            <LineChart @ref="capitalChange" Width="@width" Class="mb-4" />
        </Content>
    </Tab>
    <Tab Title="Diagram Vermögensverteilung">
        <Content>
            <DoughnutChart @ref="capitalDistrobution" Width="@halfWidth" Class="mb-4" />
        </Content>
    </Tab>
    <Tab Title="Diagram 4">
        <Content>
            <p class="mt-3">This is the placeholder content for the <b>Diagram 4</b> tab.</p>
        </Content>
    </Tab>
</Tabs>

@code {
    private BarChart inOutChart;
    private LineChart capitalChange;
    private DoughnutChart capitalDistrobution;


    private BarChartOptions chartOptions;
    private DoughnutChartOptions capitalDistrobutionOptions;
    private LineChartOptions lineChartOptions;

    private ChartData chartData;
    private ChartData chartDataCapital;
    private ChartData capitalDistrData;

    private int height { get; set; }
    private int width { get; set; }
    private int halfWidth { get; set; }

    FinLoggingDataService finLoggingDataService = new FinLoggingDataService();


    protected override void OnInitialized()
    {

        IEnumerable<FinLoggingDataRow> data = finLoggingDataService.GetDataRows();

        List<string> labels = new List<string>();
        List<double> einnahmen = new List<double>();
        List<double> ausgaben = new List<double>();
        List<double> kontostand = new List<double>();
        List<double> sparkontostand = new List<double>();
        List<double> scalable = new List<double>();
        List<double> volksbank = new List<double>();
        List<double> bargeld = new List<double>();
        List<double> urlaubskasse = new List<double>();
        List<double> total = new List<double>();

        foreach(FinLoggingDataRow row in data)
        {
            labels.Add(row.date.ToString());
            einnahmen.Add(row.einnahmen);
            ausgaben.Add(row.ausgaben);
            kontostand.Add(row.kontostand);
            sparkontostand.Add(row.sparkontostand);
            scalable.Add(row.scalableSparplan);
            volksbank.Add(row.volksbankSparplan);
            bargeld.Add(row.bargeld);
            urlaubskasse.Add(row.urlaubskasse);
            total.Add(row.totalBalance);
        }

        chartData = new ChartData
            {
                Labels = labels,
                Datasets = new List<IChartDataset>()
            };

        chartData.Datasets.Add(createDataSetFromDoubleList("Einnahmen", einnahmen, Color.LightGreen));
        chartData.Datasets.Add(createDataSetFromDoubleList("Ausgaben", ausgaben, Color.IndianRed));

        chartDataCapital = new ChartData
            {
                Labels = labels,
                Datasets = new List<IChartDataset>()
            };

        chartDataCapital.Datasets.Add(createLineDataSetFromDoubleList("Gesamtvermögen", total, Color.LightSkyBlue));

        capitalDistrData = new ChartData
        {
            Labels = new List<string> {"Kontostand", "Sparkontostand", "Scalable", "Volksbank", "Bargeld", "Urlaubsgeld"},
            Datasets = new List<IChartDataset>()
        };

        List<double> dist = new List<double> { kontostand.Last(), sparkontostand.Last(), scalable.Last(), volksbank.Last(), bargeld.Last(), urlaubskasse.Last() };
        Color[] colors = { Color.Coral, Color.Aqua, Color.DarkOliveGreen, Color.DarkSalmon, Color.Firebrick, Color.RebeccaPurple };

        capitalDistrData.Datasets.Add(createDoughnutDataSetFromDoubleList(dist, colors));

        chartOptions = new BarChartOptions
            {
                Responsive = true,
                Interaction = new Interaction { Mode = InteractionMode.Index }
            };

        lineChartOptions = new LineChartOptions
            {
                Responsive = true,
                Interaction = new Interaction { Mode = InteractionMode.Index }
            };

        capitalDistrobutionOptions = new DoughnutChartOptions
            {
                Responsive = true
            };

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await inOutChart.InitializeAsync(chartData, chartOptions);
            await capitalChange.UpdateAsync(chartDataCapital, lineChartOptions);
            await capitalDistrobution.InitializeAsync(capitalDistrData, capitalDistrobutionOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private BarChartDataset createDataSetFromDoubleList(string label, List<double> data, Color color)
    {
        return new BarChartDataset()
            {
                Label = label,
                Data = data,
                BackgroundColor = new List<string> { color.ToRgbString() },
                BorderColor = new List<string> { Color.White.ToRgbString() },
                BorderWidth = new List<double> { 1 },
            };
    }

    private DoughnutChartDataset createDoughnutDataSetFromDoubleList(List<double> data, Color[] colors)
    {
        return new DoughnutChartDataset()
            {
                Data = data,
                BackgroundColor = new List<string> { colors[0].ToRgbString(), colors[1].ToRgbString(), colors[2].ToRgbString(),
                colors[3].ToRgbString(), colors[4].ToRgbString(), colors[5].ToRgbString() },
            };
    }

    private LineChartDataset createLineDataSetFromDoubleList(string label, List<double> data, Color color)
    {
        return new LineChartDataset()
            {
                Label = label,
                Data = data,
                BackgroundColor = new List<string> { color.ToRgbString() },
                BorderColor = new List<string> { Color.LightGreen.ToRgbString() },
                BorderWidth = new List<double> { 2 },
                HoverBorderWidth = new List<double> { 4 },
                PointBackgroundColor = new List<string> { color.ToRgbString() },
                PointRadius = new List<int> { 3 },
                PointHoverRadius = new List<int> { 4 },
            };
    }

    async Task GetDimensions()
    {
        var dimension = await Service.GetDimensions();
        height = dimension.Height;
        width = dimension.Width;
        halfWidth = width / 2;
    }
    //Hier Diagrammme rein mit Tabs

}
