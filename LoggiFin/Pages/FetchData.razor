@page "/fetchdata"
@using LoggiFin.DBO;
@using LoggiFin.Data;
@using System.Globalization;
@using LoggiFin.Global;
@using LoggiFin.Services;

@inject NavigationManager uriHelper;
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IJSRuntime JS

<PageTitle>Data Input</PageTitle>

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="5000" Placement="ToastsPlacement.TopRight" />

<h1>Daten Eingeben</h1>

<ConfirmDialog @ref="dialog" />

<div>
    <p>Bitte die Daten eingeben.</p>
</div>

<div>
    <div class="mb-3">
        <label>Datum</label>
        <DateInput TValue="DateOnly" @bind-Value="@date1" Placeholder="Enter Date" />
        <label>Einnahmen</label>
        <CurrencyInput TValue="double" @bind-Value="@einnahmen" Placeholder="Einnahmen" />
        <label>Ausgaben</label>
        <CurrencyInput TValue="double" @bind-Value="@ausgaben" Placeholder="Ausgaben" />
        <label>Kontostand</label>
        <CurrencyInput TValue="double" @bind-Value="@kontostand" Placeholder="Kontostand" />
        <label>Sparkonto</label>
        <CurrencyInput TValue="double" @bind-Value="@sparkonto" Placeholder="Sparkonto" />
        <label>Scalable Sparplan</label>
        <CurrencyInput TValue="double" @bind-Value="@scalableSparplan" Placeholder="Scalable Sparplan" />
        <label>Scalable Total Invest</label>
        <CurrencyInput TValue="double" @bind-Value="@scalableTotal" Placeholder="Scalable Sparplan" />
        <label>Volksbank Sparplan</label>
        <CurrencyInput TValue="double" @bind-Value="@volksbankSparplan" Placeholder="Volksbank Sparplan" />
        <label>Volksbank Total Invest</label>
        <CurrencyInput TValue="double" @bind-Value="@volksbankTotal" Placeholder="Volksbank Sparplan" />
        <label>Beschreibung Transfer</label>
        <InputText @bind-Value="@descr">Beschreibung</InputText>
        <br /><label>Transfermenge</label>
        <CurrencyInput TValue="double" @bind-Value="@transfer" Placeholder="Transfer" />
        <label>Bargeld</label>
        <CurrencyInput TValue="double" @bind-Value="@bargeld" Placeholder="Bargeld" />
        <label>Urlaubsgeld</label>
        <CurrencyInput TValue="double" @bind-Value="@urlaubskasse" Placeholder="Urlaubskasse" />
        <Button Color="ButtonColor.Success" Outline="true" @onclick="() => sendData()"> Daten senden </Button>

        <br /><br />

        <label>Datensatz ID</label>
        <NumberInput TValue="int" @bind-Value="@datasetID" />
        <label>Kommentar</label>
        <InputText @bind-Value="@comment" />
        <Button Color="ButtonColor.Success" Outline="true" @onclick="() => sendComment()"> Kommentar senden </Button>
        
        <br /><br />
        <label>ID zum löschen</label>
        <NumberInput TValue="int" @bind-Value="@idToDelete" Placeholder="ID eingeben"  />
        <Button Color="ButtonColor.Danger" @onclick="deleteData"> Datenreihe löschen </Button>

        <br /><br />
        <label>ID zum löschen von Kommentar</label>
        <NumberInput TValue="int" @bind-Value="@idCommentToDelete" Placeholder="ID eingeben" />
        <Button Color="ButtonColor.Danger" @onclick="deleteComment"> Kommentar löschen </Button>
    </div>

    @code {
        List<ToastMessage> messages = new List<ToastMessage>();
        private DateOnly date1 = DateOnly.FromDateTime(DateTime.Now);
        private double einnahmen = 0;
        private double ausgaben = 0;
        private double kontostand = 0;
        private double sparkonto = 0;
        private double scalableSparplan = 0;
        private double volksbankSparplan = 0;
        private double transfer = 0;
        private double bargeld = 0;
        private double urlaubskasse = 0;
        private double volksbankTotal = 0;
        private double scalableTotal = 0;
        string descr = "";
        int datasetID = -1;
        string comment = "";
        DatabaseManager mngr = new DatabaseManager(GlobalProperties.debug); //schickt die Daten entweder an TestDB oder an Prod
        bool loggedIn = false;
        int uid = -1;

        private ConfirmDialog dialog;
        int idToDelete = -1;
        int idCommentToDelete = -1;

        private async void sendData()
        {
            if (loggedIn)
            {
                if (descr.Replace(" ", "") != "")
                {
                    mngr.insertDataIntoDb(uid, date1, einnahmen, ausgaben, kontostand, sparkonto,
                    scalableSparplan, volksbankSparplan, scalableTotal, volksbankTotal, descr, transfer, bargeld, urlaubskasse);

                    confirmSend();

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);


                }
                else
                {
                    denySend();
                }
            }
            else
            {
                denySend();
            }




        }

        private async void sendComment()
        {
            if (loggedIn)
            {
                if (comment.Replace(" ", "") != "")
                {
                    mngr.insertCommentForDataset(datasetID, comment);

                    confirmSend();

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {
                    denySend();
                }
            }
        }

        private async Task deleteData()
        {
            if (loggedIn)
            {
                var confirmation = await dialog.ShowAsync(
                title: "Wirklich löschen?",
                message1: "Eintrag wird gelöscht. Aktion kann nicht rückgängig gemacht werden.",
                message2: "Fortfahren?");

                if (confirmation)
                {
                    mngr.removeData(idToDelete);

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {

                }
            }

        }

        private async Task deleteComment()
        {
            if (loggedIn)
            {
                var confirmation = await dialog.ShowAsync(
                title: "Wirklich löschen?",
                message1: "Eintrag wird gelöscht. Aktion kann nicht rückgängig gemacht werden.",
                message2: "Fortfahren?");

                if (confirmation)
                {
                    mngr.deleteCommentForDataset(idCommentToDelete);

                    await Task.Delay(2000);

                    uriHelper.NavigateTo(uriHelper.Uri, forceLoad: true);
                }
                else
                {

                }
            }
        }

        private void confirmSend()
        {
            messages.Add(new ToastMessage(ToastType.Success, "Daten gesendet", $"{DateTime.Now}",
            $"Daten wurden erfolgreich übermittelt!"));
        }

        private void denySend()
        {
            messages.Add(new ToastMessage(ToastType.Danger, "Daten wurden nicht gesendet gesendet", $"{DateTime.Now}",
            $"Daten wurden nicht erfolgreich übermittelt! Bitte alles ausfüllen und anmelden"));
        }
    }
</div>

<div>

    <h4>Datenzeitraum anzeigen:</h4>
    <label for="from">Von</label>
    <DateInput TValue="DateOnly" @bind-Value="@start" id="from" onchange="@reloadGrid()" />

    <label for="to">bis</label>
    <DateInput TValue="DateOnly" @bind-Value="@end" id="to" onchange="@reloadGrid()" />

    <Grid @ref="grid"
      TItem="FinLoggingDataRow"
      Class="table table-hover table-bordered table-striped"
      DataProvider="LoggingRowDataProvider"
      AllowFiltering="true"
      AllowSorting="true"
      Responsive="true"
      RowClass="getRowClass"
      AllowPaging="true"
      PageSize="12">

    <GridColumn TItem="FinLoggingDataRow" HeaderText="Id" PropertyName="rowId">
        <Tooltip Title="@getCommentString(context.rowId)">@context.rowId</Tooltip>
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Datum" PropertyName="date" SortString="Date" SortKeySelector="item => item.date" IsDefaultSortColumn="true" SortDirection="SortDirection.Ascending">
        <Tooltip Title="@context.getProfitsAsEuro()">@context.date</Tooltip>
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Einnahmen" PropertyName="einnahmen" SortString="Einnahmen" SortKeySelector="item => item.einnahmen">
        @context.einnahmen.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Ausgaben" PropertyName="ausgaben" SortString="Ausgaben" SortKeySelector="item => item.ausgaben">
        @context.ausgaben.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Kontostand" PropertyName="kontostand" SortString="Kontostand" SortKeySelector="item => item.kontostand">
        @context.kontostand.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Sparkontostand" PropertyName="sparkontostand" SortString="Sparkontostand" SortKeySelector="item => item.sparkontostand">
        @context.sparkontostand.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Scalable Sparplan" PropertyName="scalableSparplan" SortString="Scalable Sparplan" SortKeySelector="item => item.scalableSparplan">
        @context.scalableSparplan.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Scalable Sparplan Total" PropertyName="scalableSparplan" SortString="Scalable Sparplan" SortKeySelector="item => item.scalableSparplan">
        @context.scalableSparplanTotal.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Volksbank Sparplan" PropertyName="volksbankSparplan" SortString="Volksbank Sparplan" SortKeySelector="item => item.volksbankSparplan">
        @context.volksbankSparplan.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Volksbank Sparplan Total" PropertyName="volksbankSparplan" SortString="Volksbank Sparplan" SortKeySelector="item => item.volksbankSparplan">
        @context.volksbankSparplanTotal.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Transfer" PropertyName="amountTotal" SortString="Transfer" SortKeySelector="item => item.amoutTotal">
        <Tooltip Title="@FinLoggingDataService.getTransferText(@context.rowId, uid)">@context.amoutTotal.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))</Tooltip>
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Bargeld" PropertyName="bargeld" SortString="Bargeld" SortKeySelector="item => item.bargeld">
        @context.bargeld.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Urlaubskasse" PropertyName="urlaubskasse" SortString="Urlaubskasse" SortKeySelector="item => item.urlaubskasse">
        @context.urlaubskasse.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>
    <GridColumn TItem="FinLoggingDataRow" HeaderText="Gesamtvermögen" PropertyName="gesamt" SortString="Gesamt" SortKeySelector="item => item.totalBalance">
        @context.totalBalance.ToString("C", CultureInfo.CreateSpecificCulture("de-DE"))
    </GridColumn>

</Grid>

<br />

<Button title="Export" @onclick="DownloadFileFromStream" Color="ButtonColor.Primary">Export</Button>



    @code {
        BlazorBootstrap.Grid<FinLoggingDataRow> grid = default!;
        private IEnumerable<FinLoggingDataRow> dataRows = default!;


        private DateOnly start = DateOnly.FromDateTime(DateTime.Now.Subtract(TimeSpan.FromDays(365)));
        private DateOnly end = DateOnly.FromDateTime(DateTime.Now);

        private async Task DownloadFileFromStream()
        {
            CSVExporter exporter = new CSVExporter(dataRows.ToList());
            using (var streamBuff = exporter.getFileStreamForDownload())
            {
                var fileName = "export.csv";

                using var streamRef = new DotNetStreamReference(stream: streamBuff);

                await Task.Delay(TimeSpan.FromMilliseconds(1000));

                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
        }

        protected override async Task OnInitializedAsync()
        {
            await checkLogin();
            if (!loggedIn)
            {
                uriHelper.NavigateTo("/login");
            }
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {

            await base.OnAfterRenderAsync(firstRender);
        }

        private async Task reloadGrid()
        {
            if(grid != null)
            {
                FinLoggingDataService finLoggingDataService = new FinLoggingDataService(uid, start, end);
                dataRows = finLoggingDataService.GetDataRows();
                await grid.RefreshDataAsync();
            }
        }

        private async Task<GridDataProviderResult<FinLoggingDataRow>> LoggingRowDataProvider(GridDataProviderRequest<FinLoggingDataRow> request)
        {
            await checkLogin();
            if (loggedIn)
            {
                if (dataRows is null)
                {
                    FinLoggingDataService finLoggingDataService = new FinLoggingDataService(uid, start, end);
                    dataRows = finLoggingDataService.GetDataRows();
                    
                }
                return await Task.FromResult(request.ApplyTo(dataRows));
            }
            else
            {
                return null;
            }



        }

        private string getRowClass(FinLoggingDataRow finLoggingDataRow)
        {
            if(finLoggingDataRow.ausgaben > finLoggingDataRow.einnahmen)
            {
                return "table-danger";
            }
            else
            {
                return "";
            }
        }

        private async Task checkLogin()
        {
            var token = "";
            int userId = -1;

            for (int i = 0; i < 5; i++)
            {
                try
                {
                    token = await sessionStorage.GetItemAsync<string>("LoggedIn");
                    userId = await sessionStorage.GetItemAsync<int>("uid");
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                }


                if (token != null && token.Equals("true"))
                {
                    loggedIn = true;
                    uid = userId;
                    StateHasChanged();
                    return;
                }
                else
                {
                    loggedIn = false;
                }
            }


            StateHasChanged();
        }

        private string getCommentString(int datasetID)
        {
            List<Kommentar> res = mngr.getCommentsForDataset(datasetID);

            String stringRes = "";

            foreach (Kommentar com in res)
            {
                stringRes += com.kommentarID_PK + "-" + com.kommentar + "; ";
            }

            return stringRes;
        }

}
</div>